# コピーして `.env` を作成し、ローカル用の値を入れてください。
# cp .env.example .env
#
# 本番（Render）では主に DATABASE_URL が自動設定されます（下記は開発・テスト向け）。
#
# DB だけ Docker（OrbStack 等）で動かす場合: 下記を `.env` に書いたうえで
#   docker compose up -d
# Rails はホストのまま、`LEVELY_DATABASE_HOST=localhost` で接続（`docker-compose.yml` と整合）。

# PostgreSQL 接続（開発・test 環境で database.yml から参照）
LEVELY_DATABASE_HOST=localhost
LEVELY_DATABASE_PORT=5432
LEVELY_DATABASE_USERNAME=postgres
LEVELY_DATABASE_PASSWORD=your_local_password_here
LEVELY_DATABASE_DEVELOPMENT_NAME=levely_development
LEVELY_DATABASE_TEST_NAME=levely_test

# 任意: Puma のスレッド数に合わせてプールサイズを変える場合
# RAILS_MAX_THREADS=5
