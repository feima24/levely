<%= render "devise/shared/header" %>

<div class="devise-form rpg-window">
  <% if alert.present? %><p class="alert"><%= alert %></p><% end %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { novalidate: true }) do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス", class: "rpg-field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード", class: "rpg-field-label" %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field remember-field">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "ログイン情報を記憶", class: "remember-label" %>
      </div>
    <% end %>

    <hr class="rpg-divider">

    <div class="actions">
      <button type="submit" class="rpg-menu-item rpg-menu-item--active">
        <span class="rpg-blink">▶</span>つづきから
        <span class="rpg-hint">CONTINUE</span>
      </button>
    </div>
  <% end %>

  <div class="devise-links">
    <a href="<%= new_registration_path(resource_name) %>" class="rpg-menu-item">
      <span class="rpg-blink">▶</span> はじめから<span class="rpg-hint">NEW GAME</span>
    </a>
    <a href="<%= new_password_path(resource_name) %>" class="rpg-menu-item">
      <span class="rpg-blink">▶</span> パスワードを忘れた方<span class="rpg-hint">FORGOT</span>
    </a>
  </div>
</div>

<p class="devise-footer">(c) 2026 LEVELY &nbsp;·&nbsp; PRESS ANY KEY</p>
