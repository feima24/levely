<%= render "devise/shared/header" %>

<div class="devise-form rpg-window">
  <% if alert %><p class="alert"><%= alert %></p><% end %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { novalidate: true }) do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field remember-field">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "ログイン情報を記憶", class: "remember-label" %>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit "▶ つづきから" %>
    </div>
  <% end %>

  <div class="devise-links">
    <%= link_to "▶ はじめから", new_registration_path(resource_name) %>
    <%= link_to "▶ パスワードを忘れた方", new_password_path(resource_name) %>
  </div>
</div>
