<%= render "devise/shared/header" %>

<div class="devise-form rpg-window">
  <p class="devise-desc">新しいパスワードを入力してください。</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, novalidate: true }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="field">
      <%= f.label :password, "新しいパスワード" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="actions">
      <%= f.submit "▶ パスワードを変更する" %>
    </div>
  <% end %>

  <div class="devise-links">
    <%= link_to "◀ もどる", new_session_path(resource_name) %>
  </div>
</div>
