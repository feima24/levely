<%= render "devise/shared/header" %>

<div class="devise-form rpg-window">
  <%= render "devise/shared/error_messages", resource: resource %>

  <p class="devise-desc">登録済みのメールアドレスを入力してください。</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, novalidate: true }) do |f| %>

    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="actions">
      <%= f.submit "▶ 再設定メールを送る" %>
    </div>
  <% end %>

  <div class="devise-links">
    <%= link_to "◀ もどる", new_session_path(resource_name) %>
  </div>
</div>
