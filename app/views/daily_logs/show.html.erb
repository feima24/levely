<h1><%= @date %> の学習ログ</h1>

<div data-controller="autosave" data-autosave-date-value="<%= @date %>">

  <% @learning_items.each do |item| %>
    <div data-autosave-row="<%= item.id %>"
         data-item-id="<%= item.id %>"
         data-lock-version="<%= item.lock_version %>"
         data-client-uuid="<%= item.client_uuid %>"
         style="border: 1px solid #ccc; margin: 8px; padding: 8px;">
      <input type="text" data-field="category_name"
             value="<%= item.category.name %>"
             list="categories-list"
             placeholder="カテゴリ"
             data-action="input->autosave#schedule"
             autocomplete="off">
      <textarea data-field="body_markdown"
                data-action="input->autosave#schedule"
                rows="3"><%= item.body_markdown %></textarea>
      <input type="number" data-field="duration_minutes"
             value="<%= item.duration_minutes %>"
             data-action="input->autosave#schedule"
             placeholder="学習時間（分）" min="1">
      <span data-autosave-status style="font-size:0.8em; color:gray;">保存済み</span>
      <button data-action="click->autosave#destroy">削除</button>
    </div>
  <% end %>

  <template id="new-row-template">
    <div data-autosave-row="new" data-item-id="" data-lock-version="0" data-client-uuid=""
         style="border: 1px dashed #aaa; margin: 8px; padding: 8px;">
      <input type="text" data-field="category_name"
             list="categories-list" placeholder="カテゴリ"
             data-action="input->autosave#schedule" autocomplete="off">
      <textarea data-field="body_markdown"
                data-action="input->autosave#schedule"
                rows="3" placeholder="学習ログ（Markdown）"></textarea>
      <input type="number" data-field="duration_minutes"
             data-action="input->autosave#schedule"
             placeholder="学習時間（分）" min="1">
      <span data-autosave-status style="font-size:0.8em; color:gray;">未保存</span>
      <button data-action="click->autosave#destroy">削除</button>
    </div>
  </template>

  <datalist id="categories-list">
    <% @categories.each do |cat| %>
      <option value="<%= cat.name %>">
    <% end %>
  </datalist>

  <button data-action="click->autosave#addRow">＋ 行を追加</button>
</div>
