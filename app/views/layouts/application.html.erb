<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Levely" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <!-- ゲーム風ピクセルフォント(DotGothic16)の読み込み -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <% if notice %><p class="notice"><%= notice %></p><% end %>
      <% if alert %><p class="alert"><%= alert %></p><% end %>
      <div class="app-layout">
        <nav class="sidebar">
          <%= link_to 'ホーム', monthly_path(Time.zone.today.strftime('%Y-%m')) %>
          <%= link_to '履歴', histories_path %>
          <%= link_to 'カテゴリ設定', categories_path %>
          <%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>
          <%= button_to 'アカウント削除',
                registration_path(:user),
                method: :delete,
                data: { turbo_confirm: 'アカウントを削除しますか？この操作は取り消せません。' } %>
        </nav>
        <main class="main-content">
          <%= yield %>
        </main>
      </div>
    <% else %>
      <div class="devise-wrapper">
        <%= yield %>
      </div>
    <% end %>
  </body>
