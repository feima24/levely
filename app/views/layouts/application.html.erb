<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Levely" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <!-- ゲーム風ピクセルフォント(DotGothic16)の読み込み -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice %><p class="notice"><%= notice %></p><% end %>
    <% if user_signed_in? %>
      <div class="app-layout">
        <nav class="sidebar">
          <div class="sidebar-logo">
            <span class="sidebar-logo-text">Leve1y</span>
            <span class="sidebar-logo-sub">~ Level 1Up Daily ~</span>
          </div>
          <div class="sidebar-nav">
            <%= link_to monthly_path(Time.zone.today.strftime('%Y-%m')), class: "nav-item" do %>
              <span class="nav-icon">✎</span>デイリーログ
            <% end %>
            <%= link_to histories_path, class: "nav-item" do %>
              <span class="nav-icon">👣</span>ヒストリー
            <% end %>
          </div>
        </nav>
        <div class="main-wrapper">
          <header class="main-header">
            <details class="user-menu" data-controller="dropdown">
              <summary class="user-icon-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" shape-rendering="crispEdges">
                  <rect x="5" y="1" width="6" height="6" fill="currentColor"/>
                  <rect x="3" y="9" width="10" height="6" fill="currentColor"/>
                </svg>
              </summary>
              <div class="user-dropdown">
                <%= link_to 'カテゴリ設定', categories_path, class: "dropdown-item" %>
                <%= button_to 'ログアウト', destroy_user_session_path, method: :delete,
                      class: "dropdown-item danger-item" %>
                <%= button_to 'アカウント削除', registration_path(:user), method: :delete,
                      class: "dropdown-item danger-item",
                      data: { turbo_confirm: 'アカウントを削除しますか？この操作は取り消せません。' } %>
              </div>
            </details>
          </header>
          <main class="main-content">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="devise-wrapper">
        <%= yield %>
      </div>
    <% end %>
  </body>
