<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Levely" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <!-- ゲーム風ピクセルフォント(DotGothic16)の読み込み -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice %><p class="notice"><%= notice %></p><% end %>
    <% if user_signed_in? %>
      <div class="app-shell" data-controller="search-drawer sidebar">

        <%# ヘッダー: 画面全幅 %>
        <header class="main-header">
          <button class="user-icon-btn"
                  type="button"
                  data-action="click->sidebar#toggle"
                  data-sidebar-target="toggleButton"
                  title="サイドバー折りたたみ">
            <%= render 'shared/icons/sidebar' %>
          </button>

          <div class="header-actions">
            <button class="user-icon-btn" type="button"
                    data-action="click->search-drawer#toggle"
                    data-search-drawer-target="toggleButton"
                    title="セマンティック検索">
              <%= render 'shared/icons/search' %>
            </button>
            <details class="user-menu" data-controller="dropdown">
              <summary class="user-icon-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" shape-rendering="crispEdges">
                  <rect x="5" y="1" width="6" height="6" fill="currentColor"/>
                  <rect x="3" y="9" width="10" height="6" fill="currentColor"/>
                </svg>
              </summary>
              <div class="user-dropdown">
                <%= link_to 'カテゴリ設定', categories_path, class: "dropdown-item" %>
                <%= button_to 'ログアウト', destroy_user_session_path, method: :delete,
                      class: "dropdown-item danger-item" %>
                <%= button_to 'アカウント削除', registration_path(:user), method: :delete,
                      class: "dropdown-item danger-item",
                      data: { turbo_confirm: 'アカウントを削除しますか？この操作は取り消せません。' } %>
              </div>
            </details>
          </div>
        </header>

        <%# サイドバー + メイン: ヘッダー下の領域を横分割 %>
        <div class="app-body">
          <nav class="sidebar">
              <button class="sidebar-close" type="button"
                      data-action="click->sidebar#toggle"
                      title="閉じる">✕</button>
              <div class="sidebar-logo">
                <span class="sidebar-logo-text">Levely</span>
                <span class="sidebar-logo-sub">~ Level Up Daily ~</span>
              </div>
            <div class="sidebar-nav">
              <%= link_to monthly_path(Time.zone.today.strftime('%Y-%m')),
                  class: "nav-item #{'nav-item--active' if controller_name == 'monthlies'}",
                  data: { action: "click->sidebar#close" } do %>
                <span class="nav-icon"><%= render 'shared/icons/book' %></span>デイリーログ
              <% end %>
              <% if false %>
              <%= link_to histories_path,
                          class: "nav-item",
                          data: { action: "click->sidebar#close" } do %>
        <span class="nav-icon"><%= render 'shared/icons/hourglass' %></span>ヒストリー
      <% end %>
      <% end %>
            </div>
          </nav>

          <main class="main-content">
            <%= yield %>
          </main>
          <%# 検索ドロワー %>
          <div class="search-drawer" data-search-drawer-target="panel">
          <div class="search-drawer-resize"
              data-action="mousedown->search-drawer#startResize"></div>
          <div class="search-drawer-header">
            <span class="search-drawer-title">探索</span>
            <button class="modal-close" type="button"
                    data-action="click->search-drawer#close">✕</button>
          </div>
          <form class="search-drawer-form" data-action="submit->search-drawer#search">
            <input type="text" class="search-drawer-input"
                  data-search-drawer-target="input"
                  data-action="keydown.esc->search-drawer#close"
                  placeholder="キーワードで検索..."
                  autocomplete="off">
            <button type="submit" class="search-drawer-submit">検索</button>
          </form>
          <div class="search-drawer-status" data-search-drawer-target="status"></div>
          <div class="search-drawer-summary" data-search-drawer-target="summary"></div>
          <div class="search-drawer-results" data-search-drawer-target="results"></div>
        </div>
        </div>
      </div>
    <% else %>
      <div class="devise-wrapper">
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>
