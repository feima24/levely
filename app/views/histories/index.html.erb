<h1>学習履歴</h1>

<% if @daily_logs.any? %>
  <% @daily_logs.each do |log| %>
    <div class="history-log">
      <h2>
        <%= link_to log.date.strftime('%Y年%m月%d日'), daily_log_path(log.date) %>
      </h2>

      <% log.learning_items.each do |item| %>
        <div class="history-item">
          <span class="history-category"><%= item.category.name %></span>
          <% if item.duration_minutes.present? %>
            <span class="history-duration"><%= item.duration_minutes %>分</span>
          <% end %>
          <% if item.body_markdown.present? %>
            <p class="history-body"><%= item.body_markdown %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="pagination">
    <% if @page > 1 %>
      <%= link_to '前のページ', histories_path(page: @page - 1) %>
    <% end %>
    <% if @daily_logs.size == 100 %>
      <%= link_to '次のページ', histories_path(page: @page + 1) %>
    <% end %>
  </div>
<% else %>
  <p>記録がありません。</p>
<% end %>
